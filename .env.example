# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Trên server production có thể cấp các biến này qua systemd (EnvironmentFile) thay cho file .env.

# --- Bắt buộc ---

# Token của bot: Discord Developer Portal → Application → Bot → Reset Token.
DISCORD_TOKEN=

# ID các server (guild) sẽ được đăng ký slash command, cách nhau bằng dấu phẩy.
# Lấy ID: bật Developer Mode trong Discord → chuột phải vào server → Copy Server ID.
DISCORD_GUILD_IDS=

# --- Tuỳ chọn (bỏ trống để dùng mặc định) ---

# File SQLite của bot. Mặc định: <thư mục dự án>/data/bot.db
DATABASE_PATH=

# Thư mục chứa bản sao lưu hàng ngày. Mặc định: <thư mục dự án>/data/backups
BACKUP_DIR=

# Số bản sao lưu giữ lại (1–365). Mặc định: 14
BACKUP_KEEP=

# Mức log: debug | info | warn | error. Mặc định: info
LOG_LEVEL=

# --- Trang web quản trị (tuỳ chọn, DEC-039; bỏ trống WEB_PORT để tắt) ---
# Chỉ dùng trong mạng nội bộ công ty hoặc VPN. Admin đăng nhập bằng tài khoản Discord.

# Cổng HTTP (1024–65535), ví dụ 8787.
WEB_PORT=

# Địa chỉ admin mở trong trình duyệt, không có "/" ở cuối, ví dụ http://192.168.0.206:8787
# Đăng ký thêm <WEB_BASE_URL>/auth/callback ở Developer Portal → OAuth2 → Redirects.
WEB_BASE_URL=

# Client Secret: Developer Portal → OAuth2 → Client Secret (Reset Secret). Bí mật như token, không gửi qua chat.
DISCORD_CLIENT_SECRET=

# Địa chỉ lắng nghe. Mặc định: 0.0.0.0 (mọi card mạng, để máy khác trong mạng nội bộ truy cập được)
WEB_HOST=
